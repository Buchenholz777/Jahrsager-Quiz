# JAHRSAGER – Umgebungsvariablen. Kopiere diese Datei nach .env.local und passe die Werte an.
# Es werden keine Secrets im Repository gespeichert.

# --- Allgemein ---
# Öffentliche Basis-URL (für Canonicals, Sitemap, Open Graph, Teilen-Links). Kein abschließender Slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Zeitzone für den Tageswechsel (nicht ändern, solange das Konzept Europe/Berlin vorsieht).
GAME_TIMEZONE=Europe/Berlin

# --- Datenbank ---
# Leer lassen => lokale PostgreSQL-Datenbank (PGlite, Dateien in .data/pglite). Nur für Entwicklung/Tests.
# Produktion: PostgreSQL-Verbindungsstring (z. B. Supabase "Transaction pooler"), idealerweise mit
# einer eingeschränkten Rolle (Least Privilege), siehe README.
DATABASE_URL=
# Erzwingt TLS bei DATABASE_URL (true/false). Für Supabase: true.
DATABASE_SSL=false

# --- Redaktions-Login ---
# Entweder ADMIN_PASSWORD_HASH (empfohlen, erzeugen mit `npm run admin:hash -- "Passwort"`)
# oder ADMIN_PASSWORD (nur lokal). Ohne beides ist der Admin-Bereich gesperrt.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=zeitspur-dev
# Geheimnis zum Signieren der Admin-Sitzung und Spieler-Kennungen (mindestens 32 Zeichen, zufällig!).
SESSION_SECRET=dev-only-secret-change-me-dev-only-secret

# --- Inhalte ---
# Demo-Inhalte (Platzhalterbilder, ungeprüfte Texte) im öffentlichen Spiel zulassen.
# In Produktion MUSS dies false sein.
ALLOW_DEMO_CONTENT=true
# Nur Entwicklung: Wenn für heute kein Tagespaket geplant ist, wird automatisch ein Demo-Paket angelegt.
DEMO_AUTOSCHEDULE=true
# Nur Entwicklung/Tests: Feste Uhrzeit (ISO 8601) statt echter Zeit, z. B. 2026-03-29T21:59:00Z.
# Wird in Produktion ignoriert.
ZEITSPUR_FAKE_NOW=

# --- Bildspeicher ---
# local (Dateisystem ./storage/images) oder supabase (Supabase Storage, privater Bucket)
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=zeitspur-images

# --- Betrieb ---
# Geheimnis für den Cron-Endpunkt /api/cron/veroeffentlichen (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Datenschutzfreundliche Messung (eigene Tabelle, keine Cookies, keine IPs) an/aus
ANALYTICS_ENABLED=true

# Optional: Verifizierungscode der Google Search Console (Meta-Tag-Methode)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Rechtliches (vor Launch zwingend ausfüllen, siehe README "Offene Punkte") ---
# Betreiberangaben für das Impressum. Keine erfundenen Werte verwenden!
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_EMAIL=
